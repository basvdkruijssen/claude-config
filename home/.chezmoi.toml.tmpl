{{- /* Asked once at `chezmoi init`. Answers land in
       ~/.config/chezmoi/chezmoi.toml and stay local (not in the repo). */ -}}
{{- $machineType := promptStringOnce . "machineType" "Machine type (work/personal)" "work" -}}

[data]
    machineType = {{ $machineType | quote }}

{{ if eq .chezmoi.os "windows" -}}
# Makes chezmoi run .ps1 scripts with PowerShell 7 instead of
# Windows PowerShell 5.1.
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
{{- end }}
