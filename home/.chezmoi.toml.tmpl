{{- /* Wordt eenmalig gevraagd bij `chezmoi init`. Antwoorden komen in
       ~/.config/chezmoi/chezmoi.toml en blijven lokaal (niet in de repo). */ -}}
{{- $machineType := promptStringOnce . "machineType" "Machinetype (work/personal)" "work" -}}

[data]
    machineType = {{ $machineType | quote }}

{{ if eq .chezmoi.os "windows" -}}
# Zorgt dat chezmoi .ps1-scripts met PowerShell 7 uitvoert in plaats van
# Windows PowerShell 5.1.
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]
{{- end }}
