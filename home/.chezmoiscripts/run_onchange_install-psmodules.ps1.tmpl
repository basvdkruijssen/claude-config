{{- if eq .chezmoi.os "windows" -}}
# Wordt door chezmoi uitgevoerd zodra de inhoud van dit script wijzigt
# (run_onchange_), niet bij elke apply. Installeert alleen wat ontbreekt.
#
# Alleen voor Windows: .chezmoiignore geldt niet voor scripts, dus dit bestand
# is een .tmpl dat op andere OS'en naar een lege string rendert. Chezmoi voert
# een script niet uit als de gerenderde inhoud leeg is (anders: fork/exec ...
# exec format error, want er is geen PowerShell-interpreter geconfigureerd).

$ErrorActionPreference = 'Stop'

# Az is groot (~1 GB) en duurt lang. Wil je het lichter houden, vervang 'Az' door
# alleen de modules die je gebruikt, bijvoorbeeld Az.Accounts en Az.Resources.
$modules = @(
    'Terminal-Icons'
    'Az'
    'Az.Tools.Predictor'
)

foreach ($module in $modules) {
    if (Get-Module -ListAvailable -Name $module) {
        Write-Host "$module is al aanwezig." -ForegroundColor DarkGray
        continue
    }

    Write-Host "Installeren: $module" -ForegroundColor Cyan
    Install-Module -Name $module -Repository PSGallery -Scope CurrentUser -Force -AllowClobber
}
{{- end }}
