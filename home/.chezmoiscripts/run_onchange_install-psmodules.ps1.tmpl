{{- if eq .chezmoi.os "windows" -}}
# Run by chezmoi whenever the content of this script changes (run_onchange_),
# not on every apply. Installs only what is missing.
#
# Windows only: .chezmoiignore does not apply to scripts, so this file is a
# .tmpl that renders to an empty string on other OSes. chezmoi skips a script
# whose rendered content is empty (otherwise: fork/exec ... exec format error,
# because no PowerShell interpreter is configured there).

$ErrorActionPreference = 'Stop'

# Az is large (~1 GB) and slow to install. To keep it lighter, replace 'Az' with
# only the modules you use, for example Az.Accounts and Az.Resources.
$modules = @(
    'Terminal-Icons'
    'Az'
    'Az.Tools.Predictor'
)

foreach ($module in $modules) {
    if (Get-Module -ListAvailable -Name $module) {
        Write-Host "$module is already installed." -ForegroundColor DarkGray
        continue
    }

    Write-Host "Installing: $module" -ForegroundColor Cyan
    Install-Module -Name $module -Repository PSGallery -Scope CurrentUser -Force -AllowClobber
}
{{- end }}
